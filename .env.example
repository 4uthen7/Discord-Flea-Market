# Discord Developer Portal で発行した Bot トークン
DISCORD_TOKEN=

# （任意）テスト用サーバーのID。設定するとスラッシュコマンドがそのサーバーに即時反映されます
GUILD_ID=

# （任意）PostgreSQL の接続文字列。Render など、ディスクが消える環境では必須
# 例）postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# （任意）DATABASE_URL を使わない場合の SQLite ファイルの保存先
DATABASE_PATH=fleamarket.db

# （任意）キャンセル申請に相手が返事をしないとき、申請者が単独でキャンセルできるまでの時間（既定: 72）
CANCEL_TIMEOUT_HOURS=72

# （任意）取引ページとして信頼するドメイン。これ以外のURLには購入者に警告を表示（既定: azkari.jp）
TRUSTED_TRADE_DOMAINS=azkari.jp
